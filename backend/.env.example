# Backend port
PORT=5000

# Origin allowed for CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173,https://localhost:5173

# BaniDB upstream (public, no API key required)
BANIDB_BASE_URL=https://api.banidb.com/v2

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# Optional: minimum confidence for a line match to count as "tracked"
MIN_LINE_CONFIDENCE=50
